[Unit]
Description=Sidepane — Vite dev server for agent progress UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 5173
WorkingDirectory=/mnt/external-drive/code/sidepane
Restart=on-failure
RestartSec=5
ReadWritePaths=/mnt/external-drive/code

[Install]
WantedBy=default.target
