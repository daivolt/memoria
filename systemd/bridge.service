[Unit]
Description=Bridge — chitchat → opencode feed relay
After=network-online.target opencode-serve.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/daivolt/conf/chitchat/bridge.py
Restart=on-failure
RestartSec=5
Environment=HOME=/home/daivolt
Environment=CHITCHAT_HOST=localhost
Environment=CHITCHAT_PORT=19999
Environment=CHITCHAT_ROOMS=general,logs
Environment=OPENCODE_SERVE=http://localhost:4096
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
