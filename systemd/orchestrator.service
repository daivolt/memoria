[Unit]
Description=Orchestrator — coordination-specialized memoria worker agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /home/daivolt/conf/chitchat/orchestrator.sh
Restart=on-failure
RestartSec=5
Environment=CHITCHAT_HOST=localhost
Environment=MEMORIA_URL=http://localhost:19998

[Install]
WantedBy=default.target
