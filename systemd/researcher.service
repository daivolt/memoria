[Unit]
Description=Researcher — research-specialized memoria worker agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /home/daivolt/conf/chitchat/researcher.sh
Restart=on-failure
RestartSec=5
ReadWritePaths=/mnt/external-drive/code/memoria /home/daivolt/conf/chitchat
Environment=CHITCHAT_HOST=localhost
Environment=MEMORIA_URL=http://localhost:19998

[Install]
WantedBy=default.target
